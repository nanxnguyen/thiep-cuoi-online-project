# Backend API (repo ../Thiep-cuoi-online-backend). Local dev runs it on 8090 because 8080 is often taken.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090
# Public origin of this site, for sitemap / canonical / Open Graph. REQUIRED in production (see docs/DEPLOY.md).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact email for the help and privacy pages. Leave empty until there is one.
NEXT_PUBLIC_CONTACT_EMAIL=
