{
  "name": "moc-wedding",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:next && opennextjs-cloudflare build --skipNextBuild --skipWranglerConfigCheck && node scripts/prepare-sites-worker.mjs",
    "build:next": "next build",
    "start": "next start",
    "mcp:playwright": "playwright-mcp --browser chromium --allowed-hosts localhost:3000 localhost:8090",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@formkit/auto-animate": "^0.10.0",
    "canvas-confetti": "^1.9.4",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.82",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.136.3"
  }
}
